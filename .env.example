# ==============================================================================
# QuantPilot Environment Configuration Template
# ==============================================================================
# IMPORTANT: Never commit actual API keys or secret credentials to Git!
# Copy this file to .env and configure your local settings.

# General App Settings
FLASK_ENV=development
SECRET_KEY=replace-with-a-secure-random-key
DEBUG=True
HOST=0.0.0.0
PORT=5000

# ==============================================================================
# Execution Architecture & Trading Mode (SAFETY CRITICAL)
# ==============================================================================
# TRADING_MODE: backtest | paper | live
# SAFETY NOTICE: Live order submission is disabled by default.
# Real money orders will ONLY be sent if TRADING_MODE is explicitly set to 'live'.
TRADING_MODE=paper

# Broker Type: paper | shioaji
BROKER_TYPE=paper

# Pre-Trade Risk Limits
RISK_MAX_POSITION_VALUE=500000
RISK_MAX_TOTAL_EXPOSURE=2000000
RISK_MAX_ORDER_VALUE=300000
RISK_MAX_OPEN_POSITIONS=5
RISK_MAX_TRADES_PER_DAY=50
RISK_MAX_DAILY_REALIZED_LOSS=50000
RISK_MAX_PRICE_DEVIATION_PCT=0.08
RISK_MAX_STALE_DATA_SECONDS=60.0

# ==============================================================================
# SinoPac Shioaji (Taiwan Equities) Broker Credentials
# ==============================================================================
# Leave empty if using Paper Broker.
SHIOAJI_API_KEY=
SHIOAJI_SECRET_KEY=
SHIOAJI_CERT_PATH=
SHIOAJI_CERT_PASSWORD=
SHIOAJI_PERSON_ID=
# Set to True to use SinoPac simulation environment, False for production
SHIOAJI_SIMULATION=True

# ==============================================================================
# Paper Trading Balance
# ==============================================================================
PAPER_TRADING_INITIAL_BALANCE=1000000
PAPER_TRADING_FEE_PCT=0.001425
